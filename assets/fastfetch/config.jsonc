{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "assets/fastfetch/logos/bluearch.txt"
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "title",
      "key": "💙 BlueArch"
    },

    {
      "type": "custom",
      "format": "Welcome back, Sensei."
    },

    "break",

    {
      "type": "custom",
      "key": "Version",
      "format": "0.1-dev"
    },

    {
      "type": "custom",
      "key": "Assistant",
      "format": "Arona"
    },

    {
      "type": "custom",
      "key": "Theme",
      "format": "Millennium"
    },

    "break",

    "os",
    "kernel",
    "packages",
    "de",
    "wm",
    "shell",
    "terminal",
    "cpu",
    "memory",

    "break",

    {
      "type": "datetime",
      "key": "Date"
    }
  ]
}
